############################################################
# Aplicação
############################################################

# Pasta onde os uploads serão armazenados
UPLOADS_FOLDER=./uploads


############################################################
# Emails por evento
############################################################
# Para cada evento é possível configurar:
#   *_RECEIVERS        Lista de e-mails (separados por vírgula) de interessados que
#                      receberão a notificação. O aluno solicitante é SEMPRE incluído
#                      automaticamente, então esta lista é complementar.
#   *_SUBJECT          Modelo (template Qute) do assunto. Variáveis disponíveis:
#                      {aluno}, {alunoEmail}, {titulo}, {horas} e, para mudanças de
#                      estado, {estado} e {observacao}.
#   *_MESSAGE_TEMPLATE Modelo (template Qute) do corpo do e-mail, com as mesmas variáveis.
#
# Eventos: recebido, homologado, rejeitado, pendente, concluido.
# Deixe *_RECEIVERS vazio para notificar somente o aluno.

# Evento: recebido (nova solicitação)
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_RECEBIDO_RECEIVERS=
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_RECEBIDO_SUBJECT=Certificado {titulo} recebido
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_RECEBIDO_MESSAGE_TEMPLATE=Certificado de atividade complementar recebido. Total de horas: {horas}.

# Evento: homologado
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_HOMOLOGADO_RECEIVERS=
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_HOMOLOGADO_SUBJECT=[SIGAC] - {aluno} - {titulo}
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_HOMOLOGADO_MESSAGE_TEMPLATE=O certificado de horas correspondente a {titulo} foi homologado. Observação: {observacao}.

# Evento: rejeitado
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_REJEITADO_RECEIVERS=
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_REJEITADO_SUBJECT=[SIGAC] - {aluno} - {titulo}
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_REJEITADO_MESSAGE_TEMPLATE=O certificado de horas correspondente a {titulo} foi rejeitado. Observação: {observacao}.

# Evento: pendente
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_PENDENTE_RECEIVERS=
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_PENDENTE_SUBJECT=[SIGAC] - {aluno} - {titulo}
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_PENDENTE_MESSAGE_TEMPLATE=O certificado de horas correspondente a {titulo} está pendente de análise. Observação: {observacao}.

# Evento: concluido (horas mínimas atingidas)
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_CONCLUIDO_RECEIVERS=
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_CONCLUIDO_SUBJECT=Horas complementares mínimas atingidas
BR_EDU_IFRS_POA_ATIVIDADES_COMPLEMENTARES_CONCLUIDO_MESSAGE_TEMPLATE=As horas complementares mínimas foram atingidas. Total de horas homologadas: {horas}.


############################################################
# SMTP / Mailer
############################################################

# Host SMTP
SMTP_HOST=localhost

# Porta SMTP
SMTP_PORT=25

# E-mail remetente
SMTP_EMAIL=p@example.com

# Senha SMTP
SMTP_PASSWORD=senha123


############################################################
# HTTPS / TLS
############################################################

# Caminho para certificado PKCS12 (.p12)
# HTTPS_KEYSTORE_PATH=

# Senha do certificado
# HTTPS_KEYSTORE_PASSWORD=


############################################################
# LDAP
############################################################

# URL do servidor LDAP
LDAP_URL=ldap://localhost:3890

# DN do usuário administrador LDAP
LDAP_ADMIN_DN=uid=admin,ou=people,dc=example,dc=com

# Senha do administrador LDAP
LDAP_ADMIN_PASS=senha123

# Campo identificador do usuário
LDAP_RDN_IDENTIFIER=email

# Base DN de busca de usuários
LDAP_SEARCH_BASE_DN=ou=people,dc=example,dc=com


############################################################
# LDAP - CN Mapping
############################################################

# Atributo CN
LDAP_CN_ATTRIBUTE=cn

# Filtro CN
LDAP_CN_FILTER=(member=uid={0},ou=people,dc=example,dc=com)

# Base DN CN
LDAP_CN_BASE_DN=ou=groups,dc=example,dc=com


############################################################
# LDAP - DisplayName Mapping
############################################################

# Campo displayName
LDAP_DISPLAYNAME_ATTRIBUTE=displayName

# Filtro displayName
LDAP_DISPLAYNAME_FILTER=(uid={0})

# Base DN displayName
LDAP_DISPLAYNAME_BASE_DN=ou=people,dc=example,dc=com


############################################################
# LDAP - Email Mapping
############################################################

# Campo email
LDAP_EMAIL_ATTRIBUTE=email

# Filtro email
LDAP_EMAIL_FILTER=(uid={0})

# Base DN email
LDAP_EMAIL_BASE_DN=ou=people,dc=example,dc=com


############################################################
# Banco de Dados
############################################################

# Banco utilizado
DB_PROVIDER=postgresql

# Usuário banco
DB_USER=usuario-pg

# Senha banco
DB_PASSWORD=senhapg

# URL JDBC
DB_CONNECTION_URL=jdbc:postgresql://localhost:5432/atividades

# Tamanho máximo do pool
DB_POOLSIZE=10
